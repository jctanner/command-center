+    async runNativeShell(threadId: string, shell: NativeShell, onTurnStarted?: (id: string) => void): Promise<TurnCompletedNotification> {
+        if(this.runningTurnId(threadId)) throw new Error('Wait for Codex idle before native shell execution');
+        return runNativeShell(this.connection,threadId,shell,onTurnStarted,(method,callback) => {
+            const release = this.onClientTransportEvent(event => {
+                if(event.eventType === 'notification' && event.method === method) callback(event.params);
+            });
+            return {dispose:release};
+        });
+    }
